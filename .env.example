# =============================================================================
# QUICKPACK INDIA E-COMMERCE & B2B PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Note: Keep secrets confidential. Never commit real production credentials to Git.

# Node & Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas or Local Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quickpack?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY: RAZORPAY (India Cards, UPI, Netbanking, Wallets)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_razorpay_key_id

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY: CASHFREE PAYMENTS (PG v3 API)
# -----------------------------------------------------------------------------
CASHFREE_APP_ID=replace_with_your_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_your_cashfree_secret_key
CASHFREE_ENV=TEST
# CASHFREE_ENV=PRODUCTION (for live mode)
CASHFREE_WEBHOOK_SECRET=replace_with_your_cashfree_webhook_secret

# Active Gateway Switch: "RAZORPAY" or "CASHFREE" (server configuration default)
ACTIVE_PAYMENT_GATEWAY=RAZORPAY

# -----------------------------------------------------------------------------
# CLOUDINARY (Media & Image Uploads - Optional)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=quickpack
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Transactional emails, orders, password reset)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@quickpack.in
SMTP_PASS=your_smtp_app_password
SMTP_FROM="QuickPack India" <orders@quickpack.in>

# -----------------------------------------------------------------------------
# FRONTEND VITE CONFIGURATION
# -----------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
